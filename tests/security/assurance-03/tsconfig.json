{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noCheck": false,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": [
    "fixtures-03.ts",
    "run-assurance-03.ts",
    "../assurance-02/assurance-fetch.ts",
    "../assurance-02/strict-evidence.ts",
    "../assurance-02/target-guard.ts"
  ]
}

