# Staging setup — copy locally (never commit filled values)
# Usage: SEC_SETUP_ENV_FILE=tests/security/.env.setup.local bun run security:setup-staging

SEC_SETUP_ALLOW_STAGING_WRITE=false
SEC_SETUP_SUPABASE_URL=
SEC_SETUP_SUPABASE_SERVICE_ROLE_KEY=
SEC_SETUP_SUPABASE_ANON_KEY=
SEC_SETUP_TARGET_URL=

# Shared password for all sec-test accounts (staging only — never commit real value)
SEC_TEST_PASSWORD=

SEC_TEST_ADMIN_EMAIL=sec-admin@test.local
SEC_TEST_SYSTEM_ADMIN_EMAIL=sec-system-admin@test.local
SEC_TEST_REGISTRAR_EMAIL=sec-registrar@test.local
SEC_TEST_STUDENT_AFFAIRS_EMAIL=sec-student-affairs@test.local
SEC_TEST_DEAN_EMAIL=sec-dean@test.local
SEC_TEST_VICE_DEAN_EMAIL=sec-vice-dean@test.local
SEC_TEST_DEPARTMENT_HEAD_EMAIL=sec-department-head@test.local
SEC_TEST_HR_EMAIL=sec-hr@test.local
SEC_TEST_FACULTY_EMAIL=sec-faculty@test.local
SEC_TEST_STAFF_EMAIL=sec-staff@test.local
SEC_TEST_STUDENT_A_EMAIL=sec-student-a@test.local
SEC_TEST_STUDENT_B_EMAIL=sec-student-b@test.local
SEC_TEST_FINANCE_EMAIL=sec-finance@test.local

# Optional — block known production Supabase project ref (comma-separated substrings)
# SEC_SETUP_BLOCKED_PROJECT_REFS=production-ref-here
